# ChargeNet backend environment (copy to .env and adjust)
PORT=8080
DATABASE_URL=postgres://chargenet:chargenet@localhost:5432/chargenet?sslmode=disable
JWT_SECRET=dev-secret-change-me
SIM_TIME_SCALE=10
PLATFORM_FEE_PCT=5
PUBLIC_BASE_URL=http://localhost:8080
# Origin of the standalone CPO web portal (chargenet-portal). This is the one
# origin CORS allows to send credentialed (cookie) requests.
PORTAL_ORIGIN=http://localhost:5173
MIN_START_BALANCE=10.00
# Charge transport: "ocpi" (default) charges through the real OCPI commands
# module against the CPO emulators; "local" uses the in-process simulator for
# debugging without them.
GATEWAY=ocpi

# Quotes expire after this many seconds. Rate sources are deterministic versions
# in exchange_rates; empty FX_RATE_SOURCE selects the latest effective row.
FX_RATE_SOURCE=
